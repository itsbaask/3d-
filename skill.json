{
  "name": "dola-shorts-30s",
  "version": "5.0.0",
  "description": "Reference-guided 30-second silent 3D cartoon Shorts, portrait 9:16, with six bundled reference images.",
  "author": "DOLA Shorts project",
  "license": "MIT",
  "tags": [
    "dola-shorts",
    "3d-cartoon",
    "youtube-shorts",
    "30-seconds",
    "9:16",
    "reference-guided",
    "silent-comedy",
    "desert-world"
  ],
  "defaults": {
    "duration_seconds": 30,
    "aspect_ratio": "9:16",
    "resolution": "1080x1920",
    "dialogue": false,
    "voice_over": false,
    "on_screen_text": false,
    "nonverbal_sound_effects": true,
    "loop_ending": true,
    "max_retries": 2
  },
  "characters": {
    "ZUZO_MASTER.png": "Zuzo identity and appearance",
    "MAKRON_MASTER.png": "Makron identity and appearance",
    "QARQOOSH_MASTER.png": "Qarqoosh identity and appearance",
    "SHAQLAB_MASTER.png": "Shaqlab identity and appearance",
    "CHICKEN_FAMILY_MASTER.png": "Chicken family identity and appearance",
    "DESERT_WORLD_MASTER.png": "Desert environment, palette, props and visual style"
  },
  "timeline_seconds": {
    "hook": [
      0,
      3
    ],
    "goal": [
      3,
      8
    ],
    "first_attempt": [
      8,
      16
    ],
    "escalation": [
      16,
      23
    ],
    "payoff": [
      23,
      28
    ],
    "loop_ending": [
      28,
      30
    ]
  },
  "policies": {
    "actual_media_inputs_required": true,
    "never_claim_unavailable_tool": true,
    "report_actual_duration": true,
    "external_video_api": false,
    "api_key_required": false,
    "tracker_is_bookkeeping_only": true
  },
  "bundle": {
    "build_script": "scripts/build_bundle.py",
    "workflow": ".github/workflows/build-bundle.yml",
    "artifact": "dola-shorts-30s-reference-bundle.zip"
  }
}
