{
  "name": "dola-shorts-world-class",
  "version": "6.0.0",
  "description": "Premium production workflow for 30-second vertical silent 3D cartoon Shorts with six bundled DOLA visual references and a static quality gate.",
  "author": "DOLA Shorts project",
  "license": "MIT",
  "tags": [
    "dola-shorts",
    "3d-animation",
    "youtube-shorts",
    "30-seconds",
    "9:16",
    "visual-continuity",
    "silent-comedy",
    "quality-gate"
  ],
  "defaults": {
    "duration_seconds": 30,
    "aspect_ratio": "9:16",
    "resolution": "1080x1920",
    "style": "premium stylized 3D cartoon",
    "dialogue": false,
    "voice_over": false,
    "on_screen_text": false,
    "nonverbal_sound_effects": true,
    "loop_ending": true,
    "active_characters_recommended_max": 3,
    "main_props_recommended_max": 1,
    "max_shot_changes": 4,
    "quality_gate_min_score": 40,
    "quality_gate_max_score": 50,
    "max_retries": 2
  },
  "characters": {
    "ZUZO_MASTER.png": "Zuzo identity, face, proportions, colors and signature details",
    "MAKRON_MASTER.png": "Makron identity, face, proportions, colors and signature details",
    "QARQOOSH_MASTER.png": "Qarqoosh identity, face, proportions, colors and signature details",
    "SHAQLAB_MASTER.png": "Shaqlab identity, face, proportions, colors and signature details",
    "CHICKEN_FAMILY_MASTER.png": "Chicken family identity and design",
    "DESERT_WORLD_MASTER.png": "Desert world design language, palette, environment and props"
  },
  "timeline_seconds": {
    "cold_open": [
      0,
      1
    ],
    "hook": [
      1,
      3
    ],
    "goal": [
      3,
      7
    ],
    "attempt": [
      7,
      13
    ],
    "escalation": [
      13,
      19
    ],
    "reversal": [
      19,
      24
    ],
    "payoff": [
      24,
      28
    ],
    "loop_ending": [
      28,
      30
    ]
  },
  "quality_dimensions": [
    "hook",
    "mute_readability",
    "reference_identity",
    "physical_acting",
    "vertical_composition",
    "escalation_and_payoff",
    "visual_consistency",
    "no_text_or_logos",
    "loop_ending",
    "audio_support_if_present"
  ],
  "policies": {
    "actual_media_inputs_required": true,
    "never_claim_unavailable_tool": true,
    "report_actual_duration": true,
    "external_video_api": false,
    "api_key_required": false,
    "tracker_is_bookkeeping_only": true,
    "quality_gate_is_static_only": true
  },
  "bundle": {
    "build_script": "scripts/build_bundle.py",
    "quality_gate": "scripts/quality_gate.py",
    "workflow": ".github/workflows/build-bundle.yml",
    "artifact": "dola-shorts-world-class-bundle.zip"
  }
}
